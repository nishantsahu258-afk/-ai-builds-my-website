server/uploads/*
!server/uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/

# Test coverage
coverage/

# Temporary files
*.tmp
*.temp
cookie.txt
server/data/
