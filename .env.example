# =============================================================================
# AI Builds My Website - Environment Variables
# =============================================================================
# Copy this file to .env in the server/ directory and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000

# --- MongoDB Atlas ---
# Get this from: https://cloud.mongodb.com → Clusters → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai-builds-my-website?retryWrites=true&w=majority

# --- JWT Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-very-long-random-secret-here
# Use 'false' for local development; 'true' for production HTTPS
COOKIE_SECURE=false
# 'lax' for development; 'none' for cross-origin production (requires Secure)
COOKIE_SAME_SITE=lax

# --- Google Gemini AI ---
# Get API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Default text model
GEMINI_MODEL=gemini-2.0-flash
# Vision-capable model for image analysis
GEMINI_VISION_MODEL=gemini-2.0-flash

# --- Redis (for BullMQ background jobs) ---
# Local: redis://localhost:6379
# Docker Compose: redis://redis:6379
# Managed: redis://:<password>@your-redis-host:6379
REDIS_URL=redis://localhost:6379

# --- Web Search Provider ---
# Options: 'gemini' (uses Gemini grounding) | 'tavily' | 'none'
WEB_SEARCH_PROVIDER=gemini

# Tavily API key (required only if WEB_SEARCH_PROVIDER=tavily)
# Get from: https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# --- File Storage ---
# Options: 'local' | 'cloudinary'
STORAGE_PROVIDER=local
# Directory for local uploads (relative to server root)
UPLOAD_DIR=uploads

# --- Cloudinary (optional, for production) ---
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# --- File Upload Limits ---
MAX_FILE_SIZE_MB=20
