# =============================================================================
# AI Builds My Website - Environment Variables (.env.example)
# =============================================================================
# Copy this file to server/.env and provide real credentials.
# NEVER commit server/.env to version control.
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000

# --- MongoDB Atlas ---
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai-builds-my-website?retryWrites=true&w=majority
MONGODB_URI=

# --- Authentication ---
JWT_SECRET=your-random-secret-key-at-least-32-chars
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Google Gemini API ---
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

# --- Web Search Provider ---
# Options: 'tavily' (recommended) | 'gemini' | 'none'
WEB_SEARCH_PROVIDER=tavily

# Tavily API Key (from https://tavily.com)
TAVILY_API_KEY=

# --- File Storage ---
# Options: 'local' | 'cloudinary'
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20

# --- Optional Cloudinary Storage (for production) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
