# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000

# Database (MongoDB Atlas required in production)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ai-builds-my-website?retryWrites=true&w=majority

# Authentication (Must be >= 32 chars in production)
JWT_SECRET=replace-with-strong-32-plus-character-secret
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# External AI & Search Integrations
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your-tavily-api-key

# Storage (Local filesystem; use /var/data/uploads on Render Persistent Disk)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20

# Queue (In-process queue is the default; Redis is not required)
USE_REDIS=false
